<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>PCNEssentials</groupId>
  <artifactId>PCNEssentials</artifactId>
  <version>0.0.7-SNAPSHOT</version>
  <description>PCN Utility Commands</description>
  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
  </properties>
  <build>
    <sourceDirectory>src</sourceDirectory>
  </build>
  <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
	</repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.17.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
          <groupId>net.coreprotect</groupId>
          <artifactId>coreprotect</artifactId>
          <version>19.1</version>
          <scope>system</scope>
          <systemPath>${project.basedir}/lib/CoreProtect-19.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellectualsites.plotsquared</groupId>
            <artifactId>plotsquared-core</artifactId>
            <version>7.5.12</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/plotsquared-bukkit-7.5.12.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.meteordevelopments</groupId>
            <artifactId>duels-api</artifactId>
            <version>6.2-OPTIMIZED</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Duels-Optimised-6.2.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.5.20</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/LuckPerms-Bukkit-5.5.20.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.essentialsx</groupId>
            <artifactId>EssentialsX</artifactId>
            <version>2.22.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/EssentialsX-2.22.0.jar</systemPath>
        </dependency>
    </dependencies>
</project>
